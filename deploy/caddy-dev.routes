# 页面、源码和热更新握手都必须先通过独立外层认证；应用登录不能保护开发服务器。
route {
	handle /api/* {
		# API 由 FileHop 鉴权；移除浏览器缓存的外层 Basic，保留原生 Bearer。
		@basic header_regexp Authorization "(?i)^Basic +"
		request_header @basic -Authorization
		reverse_proxy {$FILEHOP_BACKEND_UPSTREAM} {
			# 覆盖伪造来源；后端还须核对 TCP 对端是配置的精确代理地址。
			header_up X-FileHop-Client-IP {remote_host}
			transport http {
				dial_timeout {$FILEHOP_PROXY_CONNECT_TIMEOUT:5s}
				# 从请求体发完后计时，不是整个上传/下载的期限。
				response_header_timeout {$FILEHOP_PROXY_RESPONSE_HEADER_TIMEOUT:60s}
			}
		}
	}
	handle /internal/* {
		respond 404
	}
	handle {
		basic_auth {
			{$FILEHOP_DEV_USER} {$FILEHOP_DEV_PASSWORD_HASH}
		}
		# 外层凭证不进入开发服务器或上游日志。
		request_header -Authorization
		reverse_proxy {$FILEHOP_WEB_UPSTREAM}
	}
}
handle_errors {
	# 外层拒绝不是应用会话到期；客户端须保留草稿和未知发送状态。
	header X-FileHop-Access-Layer development
	header Cache-Control no-store
	respond "Development access layer error" {err.status_code}
}
