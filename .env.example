# Copy to .env; replace before any real startup. No scheme or path.
FILEHOP_DEV_HOST=transfer-dev.example.invalid
# Dedicated development network joined by the separately managed Caddy.
# Never use the production application network.
FILEHOP_DEV_NETWORK=filehop-dev-ingress
# Replace with the controlled Caddy container's stable IP on this network.
FILEHOP_TRUSTED_PROXY=192.0.2.1
